name: Portfolio Security & Deployment

on:
  push:
    branches:
      - main
      - lamini

  pull_request:
    branches:
      - main
      - lamini

jobs:

  # ==========================================
  # SONARQUBE
  # ==========================================
  sonarqube:
    name: SonarQube Scan
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: SonarQube Scan
        uses: SonarSource/sonarqube-scan-action@v6
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
          SONAR_HOST_URL: ${{ secrets.SONAR_HOST_URL }}


  # ==========================================
  # NPM AUDIT
  # ==========================================
  npm-audit:
    name: NPM Audit
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Check package.json
        id: npm_check
        run: |
          if [ -f package.json ]; then
            echo "exists=true" >> "$GITHUB_OUTPUT"
          else
            echo "exists=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Setup Node.js
        if: steps.npm_check.outputs.exists == 'true'
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install dependencies
        if: steps.npm_check.outputs.exists == 'true'
        run: npm ci

      - name: Run npm audit
        if: steps.npm_check.outputs.exists == 'true'
        run: npm audit --audit-level=high


  # ==========================================
  # SNYK
  # ==========================================
  snyk:
    name: Snyk Scan
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Check package.json
        id: npm_check
        run: |
          if [ -f package.json ]; then
            echo "exists=true" >> "$GITHUB_OUTPUT"
          else
            echo "exists=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Setup Node.js
        if: steps.npm_check.outputs.exists == 'true'
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install dependencies
        if: steps.npm_check.outputs.exists == 'true'
        run: npm ci

      - name: Install Snyk
        if: steps.npm_check.outputs.exists == 'true'
        run: npm install -g snyk

      - name: Run Snyk
        if: steps.npm_check.outputs.exists == 'true'
        run: snyk test
        env:
          SNYK_TOKEN: ${{ secrets.SNYK_TOKEN }}


  # ==========================================
  # TRIVY FILESYSTEM SCAN
  # ==========================================
  trivy-filesystem:
    name: Trivy Filesystem Scan
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Trivy filesystem scan
        uses: aquasecurity/trivy-action@master
        with:
          scan-type: fs
          scan-ref: .
          severity: HIGH,CRITICAL
          ignore-unfixed: true
          exit-code: 1


  # ==========================================
  # DOCKER BUILD + TRIVY IMAGE SCAN
  # ==========================================
  docker-security:
    name: Docker Build & Security Scan
    runs-on: ubuntu-latest
    needs:
      - sonarqube
      - trivy-filesystem

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Build Docker image
        run: |
          docker build \
            -t portfolio-app:latest .

      - name: Trivy Docker image scan
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: portfolio-app:latest
          format: table
          severity: HIGH,CRITICAL
          ignore-unfixed: true
          exit-code: 1